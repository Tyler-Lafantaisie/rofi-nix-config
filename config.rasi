configuration {
    show-icons: true;
}

* {
    bg0:     #282828;
    bg1:     #3c3836;
    bg2:     #504945;
    fg0:     #ebdbb2;
    fg1:     #d5c4a1;
    yellow:  #d79921;
    yellow-bright: #fabd2f;

    background-color: transparent;
    text-color: @fg0;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @yellow;
    border-radius: 12px;
    width: 500px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 10px;
}

inputbar {
    background-color: @bg1;
    text-color: @fg0;
    border-radius: 8px;
    padding: 10px;
    children: [ "entry" ];
}

entry {
    background-color: transparent;
    placeholder: "Search...";
    placeholder-color: @fg1;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg0;
    padding: 8px;
    border-radius: 8px;
    orientation: horizontal;
}

element selected {
    background-color: @bg2;
    text-color: @yellow-bright;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
}

element-text {
    vertical-align: 0.5;
}
entry {
    background-color: transparent;
    text-color: @fg0;
    placeholder: "Search...";
    placeholder-color: @fg1;
}
